{
  "name": "interprete-duo",
  "version": "1.0.0",
  "private": true,
  "description": "Interprete Duo — interprete vocale italiano/francese a due canali",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sync": "npm run build && npx cap sync",
    "android": "npx cap open android",
    "open": "npx cap open android",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/core": "^7.4.3",
    "@capacitor/preferences": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
